# Allowlist EXPLÍCITA para RC/corte A6 — NÃO deduzir IDs a partir de hashes.
# Grupo piloto comprovado via printenv RO no Core (Fase 7.2), NÃO via hash.
#
# Copiar para .env de corte só após GO:
#   cp .env.a6-cutover-rc.example .env.a6-cutover-rc

APP_ENV=staging
BOT_NAME=Odisseu-A6

ALLOW_ALL_GROUPS=false
STAGING_STRICT_USER_ALLOWLIST=1
STAGING_GROUP_CONFIRMED=1
STAGING_BOOTSTRAP_GROUP=0
STAGING_ALLOW_QR=0
STAGING_WHATSAPP_CONFIRM=1

# Comprovado (literal) — não derivar de sha12:
DEV_GROUP_ID=120363427684548487@g.us

# Preencher operadores um a um (LID / @c.us). Vazio = só gates de grupo.
STAGING_ALLOWED_USERS=

POKEMON_RAID_AUTO_TICK=false
POKEMON_RAID_AUTO_TICK_MS=30000
ODISSEU_BRIDGE_RAID_AUTO_TICK=false

# Token NOVO no corte (nunca reutilizar o do Core sem GO):
ODISSEU_BRIDGE_TOKEN=CHANGE_ME_GENERATE_NEW_TOKEN
