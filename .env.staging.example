# Staging M6.1/M6.3 — NÃO usar em produção. Copie para .env.staging (gitignored).
# Tokens e credenciais ficam FORA do Git.

APP_ENV=staging
PREFIX=!
BOT_NAME=Odisseu-Staging

# Restringe respostas ao chat de teste (obrigatório em staging/development).
DEV_GROUP_ID=
# Após descobrir o ID (./scripts/staging-bootstrap-group.sh), confirme:
# STAGING_GROUP_CONFIRMED=1
# Opcional: só estes números/JIDs no DEV_GROUP (vazio = qualquer membro do grupo).
# STAGING_ALLOWED_USERS=5511999999999

# Sessão WhatsApp EXCLUSIVA de staging (nunca .wwebjs_auth de produção).
WWEBJS_DATA_PATH=.wwebjs_auth_staging
WWEBJS_CLIENT_ID=staging
# Gate explícito: scripts/staging-integrated.sh exige estes flags.
# STAGING_WHATSAPP_CONFIRM=1
# STAGING_ALLOW_QR=1   # só com conta de TESTE; nunca produção
# STAGING_BOOTSTRAP_GROUP=1  # só descoberta de grupo — não processa mensagens

# Adaptador Pokémon JVM (produção continua legacy).
POKEMON_ADAPTER=jvm
POKEMON_JVM_URL=http://127.0.0.1:18090
# Compose Node: POKEMON_JVM_ALLOW_DOCKER_HOST=true + URL http://odisseu-jvm:18090
# POKEMON_JVM_ALLOW_DOCKER_HOST=false
POKEMON_JVM_TOKEN=change-me-staging-bridge-token
POKEMON_JVM_CONNECT_TIMEOUT_MS=3000
POKEMON_JVM_TIMEOUT_MS=8000

# M7.1 — bloqueio/admins via Datomic (produção força cassandra).
PLATFORM_ADAPTER=datomic
PLATFORM_JVM_URL=http://127.0.0.1:18090
PLATFORM_JVM_TOKEN=change-me-staging-bridge-token
# Compose: PLATFORM_JVM_ALLOW_PRIVATE_HOST=true e URL http://odisseu-jvm:18090
PLATFORM_JVM_ALLOW_PRIVATE_HOST=false

# Bridge JVM (mesmo token).
ODISSEU_BRIDGE_TOKEN=change-me-staging-bridge-token
ODISSEU_BRIDGE_SEED=true
ODISSEU_BRIDGE_RESET=false

# Sem segundo writer Pokémon (serviço legado desligado no staging).
POKEMON_SERVICE_URL=
POKEMON_SERVICE_TOKEN=

# Cassandra NÃO é dependência do gameplay Pokémon.
# Com profile with-cassandra, aponte para o container staging (porta host 9043).
# Sem profile: deixe vazio / unreachable — bot sobe sem persistência Node.
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=zapbot_staging

PERFORMANCE_METRICS=true
ODISSEU_RESOURCE_METRICS_ENABLED=true
CHROMIUM_DISABLE_GPU=true
CHROMIUM_LOW_RESOURCE_MODE=true
# Em macOS host, use Chrome for Testing instalado pelo Puppeteer (aspas se houver espaços):
# PUPPETEER_EXECUTABLE_PATH="/Users/voce/.cache/puppeteer/chrome/.../Google Chrome for Testing"
PUPPETEER_EXECUTABLE_PATH=

# APIs externas opcionais (degradam se ausentes).
# TMDB_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
