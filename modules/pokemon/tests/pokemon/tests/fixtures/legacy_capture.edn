;; Fixtures A6 captura — faixas rebalanceadas (auditoria gameplay).
;; chance-captura = clamp na faixa da raridade ± variação leve por poder
;; chance-base-pos-batalha = min(95, round(bonus_status * chance) + min(10, seq))
;; chance-com-bola = min(95, round(chance-base * mult))  ; pokébola lim 95
[
 {:id "magikarp-comum-neutro"
  :pokemon {:nome "Magikarp" :raridade "comum"
            :hp 20 :ataque 10 :defesa 55 :atq-esp 15 :def-esp 20 :veloc 80}
  ;; poder=200; centro 78; delta = -round((200-450)/200*4) = 5 → 83
  ;; clamp faixa comum [70,88] → 83
  :chance-especie 83
  :status nil
  :sequencia 0
  ;; base = round(1*83)+0 = 83
  :chance-base 83
  :bola "pokebola"
  :chance-bola 83}

 {:id "onix-raro-paralisado-seq3"
  :pokemon {:nome "Onix" :raridade "raro"
            :hp 80 :ataque 70 :defesa 120 :atq-esp 40 :def-esp 50 :veloc 70}
  ;; poder=430; centro 28; delta ≈ 0 → 28; faixa raro [18,38]
  :chance-especie 28
  :status :paralisado
  :sequencia 3
  ;; base = round(1.5*28)+min(10,3) = 42+3 = 45
  :chance-base 45
  :bola "ultra-bola"
  ;; min(95, round(45*2)) = 90
  :chance-bola 90}

 {:id "mewtwo-mitico-sem-status"
  :pokemon {:nome "Mewtwo" :raridade "mitico"
            :hp 120 :ataque 110 :defesa 90 :atq-esp 154 :def-esp 90 :veloc 130}
  ;; poder=694; centro 3; delta negativo → clamp lo=1 → 1? wait actual=3
  ;; runtime: chance-especie 3 (centro 3, clamp [1,6])
  :chance-especie 3
  :status nil
  :sequencia 0
  ;; base = 3+0 = 3
  :chance-base 3
  :bola "grande-bola"
  ;; min(95, round(3*1.5)) = 5
  :chance-bola 5}
]
