;; Fixtures Fase 12.8 — captura ancorada em raridade (faixas).
;; chance-captura = clamp na faixa da raridade ± variação leve por poder
;; chance-base-pos-batalha = min(95, round(bonus_status * chance) + min(10, seq))
;; chance-com-bola = min(95, round(chance-base * mult))  ; pokébola lim 95
[
 {:id "magikarp-comum-neutro"
  :pokemon {:nome "Magikarp" :raridade "comum"
            :hp 20 :ataque 10 :defesa 55 :atq-esp 15 :def-esp 20 :veloc 80}
  ;; poder=200; centro 82; delta = -round((200-450)/200*4) = -round(-5)=5 → 87
  ;; clamp faixa comum [75,90] → 87
  :chance-especie 87
  :status nil
  :sequencia 0
  ;; base = round(1*87)+0 = 87
  :chance-base 87
  :bola "pokebola"
  :chance-bola 87}

 {:id "onix-raro-paralisado-seq3"
  :pokemon {:nome "Onix" :raridade "raro"
            :hp 80 :ataque 70 :defesa 120 :atq-esp 40 :def-esp 50 :veloc 70}
  ;; poder=430; centro 40; delta = -round((430-450)/200*4)= -round(-0.4)=0 → 40
  :chance-especie 40
  :status :paralisado
  :sequencia 3
  ;; base = round(1.5*40)+min(10,3) = 60+3 = 63
  :chance-base 63
  :bola "ultra-bola"
  ;; min(95, round(63*2)) = 95? 126 → 95
  :chance-bola 95}

 {:id "mewtwo-mitico-sem-status"
  :pokemon {:nome "Mewtwo" :raridade "mitico"
            :hp 120 :ataque 110 :defesa 90 :atq-esp 154 :def-esp 90 :veloc 130}
  ;; poder=694; centro 5; delta = -round((694-450)/200*4)= -round(4.88)=-5 → 0 → lo=3
  :chance-especie 3
  :status nil
  :sequencia 0
  ;; base = 3+0 = 3
  :chance-base 3
  :bola "grande-bola"
  ;; min(95, round(3*1.5)) = 5
  :chance-bola 5}
]
