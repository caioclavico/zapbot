;; Fixtures de equivalência.
;; Pokémon: growth-v2 (xpNecessario = 10 + 2*(n-1)).
;; Treinador: curva histórica 5,7,9… (progresso-treinador-legado).

{:pokemon-xp-cases
 [{:label "Magikarp: 10 XP sobe 1 nível a partir do 1 (growth-v2)"
   :registro {:nome "Magikarp" :species "magikarp" :nivel 1 :xp-desde-nivel 0
              :hp 100 :hp-atual 80 :ataque 50 :defesa 50
              :atq-esp 50 :def-esp 50 :veloc 50 :amizade 70}
   :quantidade 10
   :expect {:nivel 2 :xp-desde-nivel 0 :subidas 1
            :hp 103 :hp-atual 83}}
  {:label "Magikarp: 8 XP não sobe"
   :registro {:nome "Magikarp" :species "magikarp" :nivel 1 :xp-desde-nivel 0
              :hp 100 :hp-atual 100 :ataque 50 :defesa 50
              :atq-esp 50 :def-esp 50 :veloc 50 :amizade 70}
   :quantidade 8
   :expect {:nivel 1 :xp-desde-nivel 8 :subidas 0 :hp 100 :hp-atual 100}}
  {:label "Geodude: desmaiado não recupera HP ao subir (10 XP = L1→L2)"
   :registro {:nome "Geodude" :species "geodude" :nivel 1 :xp-desde-nivel 0
              :hp 100 :hp-atual 0 :ataque 40 :defesa 80
              :atq-esp 30 :def-esp 30 :veloc 20 :amizade 70}
   :quantidade 10
   :expect {:nivel 2 :xp-desde-nivel 0 :subidas 1 :hp 103 :hp-atual 0}}]

