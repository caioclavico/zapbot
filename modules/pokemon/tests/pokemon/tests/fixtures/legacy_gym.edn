;; Equivalência ginásio vs legado (aventuras + ginasios + core).
{:catalog
 [{:id "pedra" :nivel 10 :item "pedra-lua"}
  {:id "agua" :nivel 20 :item "pedra-agua"}
  {:id "eletrico" :nivel 30 :item "pedra-trovao"}
  {:id "planta" :nivel 40 :item "pedra-folha"}
  {:id "fogo" :nivel 50 :item "pedra-fogo"}]

 :unlock
 [{:insignias #{} :gym "pedra" :ok true}
  {:insignias #{} :gym "agua" :ok false}
  {:insignias #{"pedra"} :gym "agua" :ok true}
  {:insignias #{"pedra" "agua"} :gym "eletrico" :ok true}]

 ;; Atividade growth-v1: vitória=4 / derrota=2 +1 por nocaute. premio ignorado.
 :xp-participante
 [{:venceu? false :premio nil :nocautes 2 :xp 4}
  {:venceu? true :premio :primeira :nocautes 0 :xp 4}
  {:venceu? true :premio :revanche :nocautes 1 :xp 5}
  {:venceu? true :premio nil :nocautes 0 :xp 4}]

 ;; Economia A6: vitória/conquista NÃO concede moedas; PE de batalha saiu deste mapa.
 :recompensa-vitoria
 [{:premio :primeira :pedra-roll 99 :moedas 0 :pe 0 :pedra? true}
  {:premio :revanche :pedra-roll 10 :moedas 0 :pe 0 :pedra? true}
  {:premio :revanche :pedra-roll 50 :moedas 0 :pe 0 :pedra? false}]

 :motivacao
 [{:base [100 100 100] :horas 0 :expect [100 100 100]}
  ;; 10h * 5 = 50 → 50; mínimo 20
  {:base [100 100 100] :horas 10 :expect [50 50 50]}
  {:base [100 100 100] :horas 20 :expect [20 20 20]}
  {:base [40 40 40] :defesa true :expect [28 28 28]}]

 :fator-stats
 [{:motivacao 100 :fator 1.0}
  {:motivacao 20 :fator 0.6}]

 ;; Política canônica A6: min(100, floor(seg*100/28800)); mín. 30 min; teto ocupação 100.
 :permanencia
 [{:ms 0 :moedas 0 :xp 0}
  {:ms 1 :moedas 0 :xp 1}
  {:ms 540000 :moedas 0 :xp 1}      ;; 9 min
  {:ms 1200000 :moedas 0 :xp 1}     ;; 20 min
  {:ms 1740000 :moedas 0 :xp 1}     ;; 29 min
  {:ms 1800000 :moedas 6 :xp 1}     ;; 30 min → 6
  {:ms 3600000 :moedas 12 :xp 2}    ;; 1 h → 12
  {:ms 7200000 :moedas 25 :xp 4}    ;; 2 h → 25
  {:ms 14400000 :moedas 50 :xp 8}   ;; 4 h → 50
  {:ms 21600000 :moedas 75 :xp 12}  ;; 6 h → 75
  {:ms 28800000 :moedas 100 :xp 16} ;; 8 h → 100
  {:ms 43200000 :moedas 100 :xp 24}] ;; 12 h → 100 (cap 8h)
}
