{:source-paths ["src"]
 :dependencies [[funcool/promesa "12.0.0"]]
 :builds
 {:app {:target :node-script
        :main zapbot.core/main
        :output-to "target/main.js"
        ;; :simple avoids Closure Closure's property renaming, which would
        ;; otherwise break dot-interop with npm objects (rss-parser items,
        ;; whatsapp-web.js Chat/Contact/Message, etc.)
        :compiler-options {:optimizations :simple}}
  :migrar-estado {:target :node-script
                   :main zapbot.migrar-estado/-main
                   :output-to "target/migrar-estado.js"
                   :compiler-options {:optimizations :simple}}}}
