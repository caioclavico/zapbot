# =============================================================================
# A6 staging ISOLADO — NÃO copiar .env / tokens / sessão do Core A5.6
# =============================================================================
# Uso futuro:
#   cp .env.a6-staging.example .env.a6-staging
#   # Gerar token NOVO (não reutilizar ODISSEU_BRIDGE_TOKEN do Core):
#   openssl rand -hex 32   → preencher ODISSEU_BRIDGE_TOKEN
#   # Preencher DEV_GROUP_ID só após descoberta no grupo de TESTE
#   # Só então STAGING_GROUP_CONFIRMED=1
#
# Nunca apontar ODISSEU_BRIDGE_* para odisseu-m90-core / core / volumes a56.
# =============================================================================

# --- Identidade ---
APP_ENV=staging
BOT_NAME=Odisseu-A6-Staging

# --- Autorização fail-closed (obrigatório nesta preparação) ---
ALLOW_ALL_GROUPS=false
STAGING_GROUP_CONFIRMED=0
STAGING_STRICT_USER_ALLOWLIST=1
STAGING_BOOTSTRAP_GROUP=0
STAGING_ALLOW_QR=0
STAGING_WHATSAPP_CONFIRM=0
# Preencher só após descoberta explícita do grupo de TESTE:
DEV_GROUP_ID=
STAGING_ALLOWED_USERS=

# --- Transporte WhatsApp (homolog local: disabled) ---
WHATSAPP_TRANSPORT=disabled
HEALTH_BIND_HOST=0.0.0.0

# --- Kill switch raides automáticas (OFF) ---
POKEMON_RAID_AUTO_TICK=false
POKEMON_RAID_AUTO_TICK_MS=30000

# --- Bridge JVM (token NOVO; nunca copiar do Core) ---
ODISSEU_BRIDGE_TOKEN=CHANGE_ME_GENERATE_NEW_TOKEN
# Identificadores Datomic exclusivos (já fixos no compose; espelhados aqui p/ docs):
# ODISSEU_BRIDGE_SYSTEM=odisseu-a6-staging
# ODISSEU_BRIDGE_DB=core-a6-staging
# ODISSEU_PLATFORM_DB=platform-a6-staging
ODISSEU_BRIDGE_SEED=false
ODISSEU_BRIDGE_RESET=false
ODISSEU_BRIDGE_ALLOW_TEST_RNG=false
# Lab sintético apenas — default false; Fase 5.5 liga sob controle:
# ODISSEU_BRIDGE_RAID_AUTO_TICK=true
ODISSEU_BRIDGE_RAID_AUTO_TICK=false

# --- Adapter Node → JVM A6 (só rede compose a6-staging-internal) ---
POKEMON_ADAPTER=jvm
POKEMON_JVM_ALLOW_DOCKER_HOST=true
PLATFORM_ADAPTER=datomic
PLATFORM_JVM_ALLOW_PRIVATE_HOST=true

# --- APIs externas (opcional; deixe vazio se não for testar) ---
# TMDB_API_KEY=
# GEMINI_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
