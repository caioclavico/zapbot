# Métricas opcionais de desempenho (false elimina coleta e logs de tempos).
PERFORMANCE_METRICS=false

# Somente interface interna de ovos; não publica API ou comandos.
# Exige o schema aditivo Adventure Sync instalado separadamente.
ADVENTURE_SYNC_ENABLED=true
SAVE_TRANSITIONS_ENABLED=false
# Só habilite após inventariar/certificar a cobertura de journals anteriores.
SAVE_TRANSITIONS_LEGACY_COVERAGE_VERIFIED=false
# Probabilidades de ovos (0 a 100); raro é sorteado somente se não houver épico.
EGG_CAPTURE_COMMON_PERCENT=10
EGG_PVP_EPIC_PERCENT=3
EGG_PVP_RARE_PERCENT=20

# API privada; 0.0.0.0 exige API_TOKEN e firewall restrito à VM ZapBot.
HOST=127.0.0.1
PORT=8090
API_TOKEN=
DATA_DIR=./data
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=zapbot
# Opcional: autenticação do cliente principal (PasswordAuthenticator / harness).
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# Canonical per-player trainer store. Keep disabled until Cassandra roles,
# additive schema, immutable backups and legacy-writer revocation are certified.
CANONICAL_TRAINER_ENABLED=false
CANONICAL_TRAINER_USERNAME=
CANONICAL_TRAINER_PASSWORD=
# Canonical gym persistence stays off until backup, migration, and role grants are verified.
CANONICAL_GYMS_ENABLED=false
CANONICAL_GYMS_USERNAME=
CANONICAL_GYMS_PASSWORD=
PREFIX=!
BOT_NAME=Odisseu
MISSOES_TIMEZONE=America/Sao_Paulo
# Só a tradução da Pokédex usa estes valores opcionais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
