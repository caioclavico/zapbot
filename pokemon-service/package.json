{
  "name": "zapbot-pokemon-service",
  "version": "0.21.0",
  "private": true,
  "description": "Dom\u00ednio Pok\u00e9mon independente com API HTTP e Cassandra",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "shadow-cljs release domain",
    "test": "node --test test/*.test.cjs",
