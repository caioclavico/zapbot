    "test:historical-recovery:e2e": "bash scripts/test-a63-recovery-e2e.sh",
    "test:save-slots:cassandra": "bash scripts/test-save-slots-cassandra.sh",
    "test:adventure-fence:cassandra": "bash scripts/test-adventure-fence-cassandra.sh",
    "test:adventure-birth:cassandra": "bash scripts/test-adventure-birth-cassandra.sh",
    "test:loja-save-binding:cassandra": "bash scripts/test-loja-save-binding-cassandra.sh",
    "test:lateral-intent:cassandra": "bash scripts/test-lateral-intent-cassandra.sh",
    "test:loja-intent:cassandra": "bash scripts/test-loja-intent-cassandra.sh",
    "start": "node runtime/main.cjs"
  },
  "dependencies": {
    "cassandra-driver": "^4.7.2",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.3"
  },
