{:source-paths ["src" "test"]
 :dependencies [[funcool/promesa "12.0.0"]]
 :builds
 {:domain {:target :node-library
           :output-to "target/domain.cjs"
           :exports {:diagnostics pokemon-service.entry/diagnostics
                     :initialize pokemon-service.entry/initialize
                     :isReady pokemon-service.entry/is-ready
                     :shutdown pokemon-service.entry/shutdown
                     :shutdownPending pokemon-service.entry/shutdown-pending
                     :command pokemon-service.entry/command
                     :startTimers pokemon-service.entry/start-timers
                     :stopTimers pokemon-service.entry/stop-timers
                     :load pokemon-service.entry/load-state
                     :store pokemon-service.entry/store-state
                     :registerModule pokemon-service.entry/register-module
                     :reserve pokemon-service.entry/reserve
                     :takeEffects pokemon-service.entry/take-effects
                     :eggsActivate pokemon-service.entry/eggs-activate
                     :eggsCreate pokemon-service.entry/eggs-create
                     :eggsIncubate pokemon-service.entry/eggs-incubate
                     :eggsDistance pokemon-service.entry/eggs-distance
                     :eggsState pokemon-service.entry/eggs-state
                     :eggsRecover pokemon-service.entry/eggs-recover
                     :eggsHistory pokemon-service.entry/eggs-history
                     :activityActivate pokemon-service.entry/activity-activate
                     :activityIncubate pokemon-service.entry/activity-incubate
                     :activityDrain pokemon-service.entry/activity-drain
                     :activityGrantIncubator pokemon-service.entry/activity-grant-incubator
                     :activityPoints pokemon-service.entry/activity-points
                     :activityState pokemon-service.entry/activity-state
                     :activityTime pokemon-service.entry/activity-time
                     :activityTick pokemon-service.entry/activity-tick
                     :saveSlotsImport pokemon-service.entry/save-slots-import
                     :saveSlotsList pokemon-service.entry/save-slots-list
                     :saveSlotMetadata pokemon-service.entry/save-slot-metadata
                     :saveActivate pokemon-service.entry/save-activate
                     :saveHydratePlayer pokemon-service.entry/save-hydrate-player}
           :compiler-options {:optimizations :simple}}
  :benchmark {:target :node-library :output-to "target/benchmark.cjs"
              :exports {:render pokemon-benchmark/render
                        :battle pokemon-benchmark/battle
                        :raid pokemon-benchmark/raid
                        :team pokemon-benchmark/team}
              :compiler-options {:optimizations :simple}}
  :test {:target :node-test :output-to "target/test.js" :ns-regexp "-test$"}}}
