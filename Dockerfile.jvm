# Bridge JVM + Datomic Local (odisseu-core / staging).
# Sem porta pública — Compose publica só 127.0.0.1:18090.
# Multi-arch: eclipse-temurin:21-jdk-jammy (linux/amd64 e linux/arm64).
# Preferir build NA VM alvo (arquitetura nativa). Em Mac arm64 → VM amd64:
#   docker build --platform linux/amd64 -f Dockerfile.jvm -t odisseu-jvm .
# curl é obrigatório para HEALTHCHECK.
FROM eclipse-temurin:21-jdk-jammy

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates rlwrap \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/linux-install.sh https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh \
    && chmod +x /tmp/linux-install.sh \
    && /tmp/linux-install.sh \
    && rm /tmp/linux-install.sh

WORKDIR /app

# Prefetch deps (cache de layer)
COPY deps.edn ./
RUN clojure -P -M:bridge-http

COPY apps ./apps
COPY shared ./shared
COPY modules ./modules
COPY migrations ./migrations

# Defaults neutros — Compose odisseu-core sobrescreve system/db/storage.
ENV ODISSEU_BRIDGE_HOST=0.0.0.0 \
    ODISSEU_BRIDGE_PORT=18090 \
    ODISSEU_BRIDGE_ALLOW_PRIVATE_BIND=true \
    ODISSEU_BRIDGE_SYSTEM=odisseu-m90-core \
    ODISSEU_BRIDGE_STORAGE=/data/datomic-local \
    ODISSEU_BRIDGE_DB=core \
    ODISSEU_PLATFORM_DB=platform \
    ODISSEU_PLATFORM_ENABLED=true \
    ODISSEU_BRIDGE_SEED=false \
    ODISSEU_BRIDGE_RESET=false \
    ODISSEU_BRIDGE_ALLOW_TEST_RNG=false

VOLUME ["/data/datomic-local"]
EXPOSE 18090

# GET /health é público (sem Authorization). Ver bridge.clj.
HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=8 \
  CMD curl -fsS -m 4 http://127.0.0.1:18090/health || exit 1

CMD ["clojure", "-M:bridge-http"]
