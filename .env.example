# Prefixo dos comandos do bot (ex.: com "!" o comando de piada fica "!piada")
PREFIX=!

# Números que podem usar comandos administrativos (ex.: !ban) mesmo sem serem
# admins do grupo. Formato: DDI+DDD+numero@c.us, separados por vírgula.
# Exemplo: 5511999999999@c.us,5521988888888@c.us
ADMIN_NUMBERS=

# Cidade padrão usada quando "!previsao" é chamado sem argumentos
WEATHER_DEFAULT_CITY=Sao Paulo

# Feed RSS usado pelo comando "!noticias"
NEWS_FEED_URL=https://g1.globo.com/rss/g1/

# Pares de moeda padrão usados pelo comando "!cotacao" (separados por vírgula)
CURRENCY_DEFAULT=USD-BRL,EUR-BRL,BTC-BRL

# Caminho do executável do Chromium do sistema. Necessário em ARM64/Docker,
# onde o Puppeteer não baixa um Chromium próprio (ex.: Oracle Cloud Free Tier).
# Deixe vazio em uma máquina x86 local (o Puppeteer baixa o Chromium sozinho).
PUPPETEER_EXECUTABLE_PATH=

# Chave gratuita da TMDB (The Movie Database), usada pelo comando "!filme"
# (sinopse, nota e sugestões aleatórias). Cadastre-se e peça uma chave de API
# (v3 auth) em https://www.themoviedb.org/settings/api - grátis, aprovação rápida.
TMDB_API_KEY=

# Chave gratuita da API Gemini (Google AI Studio), usada pelo comando "!resuma"
# para resumir as últimas mensagens do chat. Pegue a sua em
# https://aistudio.google.com/apikey - grátis, sem cartão.
GEMINI_API_KEY=

# Modelo Gemini a usar (opcional, padrão gemini-3.5-flash-lite). Evite valores
# terminados em "-latest": esse alias troca de modelo sem aviso prévio e pode
# virar um modelo "thinking" bem mais pesado, aumentando erros 503 (modelo
# sobrecarregado). Veja os nomes disponíveis em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=

# Credenciais gratuitas do Spotify (Client Credentials), usadas pelo comando
# "!musica" para indicar músicas com link do Spotify. Crie um app em
# https://developer.spotify.com/dashboard - grátis, aprovação imediata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cassandra usado para persistir rank, loja, admins conhecidos, participantes
# e histórico do quiz (ver zapbot.armazenamento). Com o docker-compose.yml
# deste projeto, o serviço se chama "cassandra" (não precisa mudar nada aqui
# pra rodar com `docker compose up`); pra um cluster próprio/gerenciado,
# ajuste os 3 valores abaixo.
CASSANDRA_CONTACT_POINTS=cassandra
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=zapbot

# Restringe o bot a um único chat de teste quando estiver rodando uma
# instância local em paralelo com a de produção (evita responder duplicado
# nos grupos reais). Deixe os dois vazios/como estão em produção.
APP_ENV=production
DEV_GROUP_ID=
