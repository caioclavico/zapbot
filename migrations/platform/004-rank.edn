;; M7.4 — schema Datomic Local para rank (sintético / staging).
;; Shape legado: chat → player → {nome, pontos, jogos{}, efeitos-pokemon-http{}}.
;; Recibos de pontuação usam :platform.op/* (idempotência por operation-id).
[
 {:db/ident       :platform.rank.player/key
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique      :db.unique/identity
  :db/doc         "chat-id|player-id"}

 {:db/ident       :platform.rank.player/chat
  :db/valueType   :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc         "Jogador no placar → chat."}

 {:db/ident       :platform.rank.player/player-id
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one}

 {:db/ident       :platform.rank.player/name
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one}

 {:db/ident       :platform.rank.player/points
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one}

 {:db/ident       :platform.rank.player/games
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Mapa jogo→vitórias como EDN."}

 {:db/ident       :platform.rank.player/http-only?
  :db/valueType   :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc         "Marcador legado somente-efeitos-http."}

 {:db/ident       :platform.rank.player/effects
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Mapa efeitos-pokemon-http (id→payload) como EDN."}
]
