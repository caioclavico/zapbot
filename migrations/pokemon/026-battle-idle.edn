;; Idle timeout de batalhas — last-activity/expires absolutos + outbox de notificação.
[
 {:db/ident       :battle/last-activity-at
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "Epoch ms da última ação válida aceita"}

 {:db/ident       :battle/idle-expires-at
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
