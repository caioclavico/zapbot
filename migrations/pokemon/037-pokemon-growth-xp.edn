;; Progressão oficial de XP dos Pokémon (PokéAPI growth-rate).
;; Aditiva após 036. Não backfill — conversão lazy/idempotente em growth-v1.
[
 {:db/ident       :pokemon/xp-total
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "XP acumulado canônico (growth-v1). Ausente = legado residual em :pokemon/xp-desde-nivel."}

 {:db/ident       :pokemon/xp-progress-version
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Versão da semântica de XP. \"growth-v1\" = curvas oficiais; ausente = residual legado limiar 9."}

 {:db/ident       :pokemon/xp-legacy-residual
  :db/valueType   :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc         "Residual legado preservado na primeira conversão growth-v1 (auditoria)."}

 {:db/ident       :pokemon/growth-rate
  :db/valueType   :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc         "Curva aplicada na última conversão/escrita (erratic|fast|medium-fast|medium-slow|slow|fluctuating)."}
]
