# Odisseu Core (M9.0) — VM Google `odisseu-core`.
# Copie para .env.odisseu-core (gitignored). NÃO use na VM odisseu-zapbot.
# Tokens ficam FORA do Git. Sem cutover / sem Cassandra de produção.

APP_ENV=staging
PREFIX=!
BOT_NAME=Odisseu-Core

# Obrigatório após descoberta do grupo de teste (bootstrap).
DEV_GROUP_ID=
# Confirme só depois de validar o ID do grupo:
# STAGING_GROUP_CONFIRMED=1
# Allowlist de remetentes no grupo (recomendado na VM):
# STAGING_ALLOWED_USERS=5511999999999

# Sessão WhatsApp EXCLUSIVA desta VM (nunca .wwebjs_auth de produção).
# Host: .wwebjs_auth_core/  |  Container (Compose): /app/.wwebjs_auth_core
# APP_ENV=staging rejeita /app/.wwebjs_auth (path de produção).
WWEBJS_DATA_PATH=.wwebjs_auth_core
WWEBJS_CLIENT_ID=core

# Gates explícitos — scripts exigem confirmação antes de WhatsApp “aberto”.
# STAGING_WHATSAPP_CONFIRM=1
# STAGING_ALLOW_QR=1          # só conta Business de TESTE
# STAGING_BOOTSTRAP_GROUP=1   # só descoberta de grupo (sem comandos)

# Adaptadores (produção odisseu-zapbot permanece legacy/cassandra).
POKEMON_ADAPTER=jvm
POKEMON_JVM_URL=http://127.0.0.1:18090
POKEMON_JVM_TOKEN=change-me-odisseu-core-bridge-token
POKEMON_JVM_CONNECT_TIMEOUT_MS=3000
POKEMON_JVM_TIMEOUT_MS=8000

PLATFORM_ADAPTER=datomic
PLATFORM_JVM_URL=http://127.0.0.1:18090
PLATFORM_JVM_TOKEN=change-me-odisseu-core-bridge-token
# Dentro do Compose a URL vira http://odisseu-jvm:18090 via environment override.
PLATFORM_JVM_ALLOW_PRIVATE_HOST=false

# Bridge JVM — mesmo token nos três lados.
ODISSEU_BRIDGE_TOKEN=change-me-odisseu-core-bridge-token
ODISSEU_BRIDGE_SEED=false
ODISSEU_BRIDGE_RESET=false
ODISSEU_BRIDGE_ALLOW_TEST_RNG=true

# Sem writer Pokémon legado / sem Cassandra nesta VM.
POKEMON_SERVICE_URL=
POKEMON_SERVICE_TOKEN=
# Pontos Cassandra irrelevantes com PLATFORM_ADAPTER=datomic + POKEMON_ADAPTER=jvm
# (cassandra-boot-enabled? = false). Deixe unreachable se presente.
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=zapbot_core_unused

PERFORMANCE_METRICS=true
ODISSEU_RESOURCE_METRICS_ENABLED=true
CHROMIUM_DISABLE_GPU=true
CHROMIUM_LOW_RESOURCE_MODE=true
# Na imagem Docker: /usr/bin/chromium (Compose já força).
PUPPETEER_EXECUTABLE_PATH=

# APIs externas opcionais.
# TMDB_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
